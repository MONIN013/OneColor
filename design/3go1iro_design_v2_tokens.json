  "typography": {
    "display": {
      "fontFamily": "Noto Serif CJK JP / Hiragino Mincho ProN / serif",
      "sizes": {
        "hero": 34,
        "screenTitle": 30,
        "word": 42,
        "cardWord": 24
      }
    },
    "ui": {
      "fontFamily": "Noto Sans CJK JP / system-ui / sans-serif",
      "sizes": {
        "label": 12,
        "body": 14,
        "button": 16
      }
    }
  },
  "radii": {
    "sm": 10,
    "md": 18,
    "lg": 24,
    "xl": 32,
    "phone": 38
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "touchTargets": {
    "minimumCssPx": 44,
    "preferredMobilePx": 48
  },
  "components": {
    "WordInput": {
      "height": 104,
      "radius": 22,
      "maxChars": 8,
      "states": [
        "empty",
        "active",
        "filled",
        "warning",
        "error"
      ]
    },
    "ColorChip": {
      "size": 32,
      "radius": 10,
      "showName": true
    },
    "CalendarCell": {
      "visualSize": 40,
      "targetSize": 48,
      "states": [
        "empty",
        "filled",
        "selected",
        "blank"
      ]
    },
    "DayCard": {
      "radius": 34,
      "usesDayColorAsBackground": true
    },
    "Reaction": {
      "types": [
        "色で返す",
        "3語で返す"
      ]
    }
  }
}
